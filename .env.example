# Gemeinsame Konfiguration; eigene zufällige Werte mit openssl rand -hex 32 erzeugen.
SECRET_KEY=
API_TOKEN=
# Separater Schreibschlüssel nur für API und Collector; niemals API_TOKEN kopieren.
COLLECTOR_API_TOKEN=
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=
# Optional statt Startpasswort: vorhandener Werkzeug-Passworthash.
INIT_ADMIN_PASSWORD_HASH=

# Lokaler Port und dauerhafte Daten auf dem Docker-Host.
PORT=8501
HOST_DATA_DIR=./data
# Bestehendes DATA_DIR bleibt Hostalias, solange HOST_DATA_DIR nicht gesetzt ist.

# Direktstart ohne Compose; im Compose-Netz ist die Adresse fest http://api:8001.
API_URL=http://127.0.0.1:8001
API_TIMEOUT_SECONDS=5
# Großes Dashboard-Zeitfenster; Health bleibt separat auf 2 Sekunden begrenzt.
API_DASHBOARD_TIMEOUT_SECONDS=20

# Die Overlays setzen die passenden Werte für Lokal/Webserver.
SESSION_COOKIE_SECURE=false
# Weitere Instanzen auf demselben Host erhalten einen eigenen Cookie-Namen.
# Ohne Wert bleibt solarbank_session bzw. __Host-solarbank_session bei HTTPS.
# SESSION_COOKIE_NAME=solarbank_nord_session
SESSION_HOURS=8
CANONICAL_ORIGIN=https://kraftwerk.fluxo.io
TRUST_PROXY=false
REVERSE_PROXY_NETWORK=reverse-proxy

# Projektspezifisch: Anker-Cloud und Dashboard.
ANKER_USERNAME=
ANKER_PASSWORD=
ANKER_COUNTRY=DE
ANKER_DEVICE_SN=
ANKER_PAYLOAD_ENCRYPTION=false
POLL_INTERVAL_SECONDS=300
API_REQUEST_TIMEOUT_SECONDS=90
MAX_RETRIES=2
LOG_LEVEL=INFO
AUTH_ENABLED=true
DASHBOARD_TIMEZONE=Europe/Berlin
ANKER_SOURCE_TIMEZONE=
