# Anker-Eigentümerkonto
ANKER_USERNAME=name@example.com
ANKER_PASSWORD=change-me
ANKER_COUNTRY=DE

# Leer lassen, um alle Solarbanken des Kontos zu erfassen.
ANKER_DEVICE_SN=
ANKER_PAYLOAD_ENCRYPTION=false

# Mindestens 60 Sekunden; 300 Sekunden entsprechen fünf Minuten.
POLL_INTERVAL_SECONDS=300
API_REQUEST_TIMEOUT_SECONDS=90
MAX_RETRIES=2
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=solarbank
POSTGRES_USER=solarbank
POSTGRES_PASSWORD=change-me-too
POSTGRES_PORT=5432

# Dashboard
DASHBOARD_DB_USER=solarbank_dashboard
DASHBOARD_DB_PASSWORD=change-me-dashboard
DASHBOARD_PORT=8501
DASHBOARD_TIMEZONE=Europe/Berlin
# Zeitzone der Anker-Messzeit; leer = unbekannt (z. B. Europe/Berlin).
ANKER_SOURCE_TIMEZONE=

# Anmeldung für einen öffentlichen HTTPS-Betrieb.
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_AUTH_USERNAME=admin
# Scrypt-Hash in einfachen Anführungszeichen eintragen.
DASHBOARD_AUTH_PASSWORD_HASH=
DASHBOARD_SECRET_KEY=
DASHBOARD_HEALTH_TOKEN=
DASHBOARD_AUTH_SECURE_COOKIE=true
DASHBOARD_AUTH_SESSION_HOURS=12
# Nur auf die genaue Anzahl vorgeschalteter Reverse Proxies setzen.
DASHBOARD_TRUSTED_PROXY_COUNT=0
# Kommagetrennte öffentliche Hostnamen, ohne Schema.
DASHBOARD_TRUSTED_HOSTS=
