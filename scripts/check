#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
python3 -B scripts/check_webapp.py
npm --prefix frontend ci --no-audit --no-fund
npm --prefix frontend run check
npm --prefix frontend run build
PYTHONPATH=web/src:api/src:collector/src PYTHONDONTWRITEBYTECODE=1 python3 -B -m pytest tests --import-mode=importlib -p no:cacheprovider -q
python3 -B scripts/check_compose.py
